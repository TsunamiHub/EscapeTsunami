import { useState } from "react";

export default function Home() {
  const script = `loadstring(game:HttpGet("https://raw.githubusercontent.com/TsunamiHub/EscapeTsunami/refs/heads/main/TsunamiHubOfficial"))()`;

  const [copied, setCopied] = useState(false);

  const copyScript = async () => {
    await navigator.clipboard.writeText(script);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div style={styles.container}>
      <h1 style={styles.title}>Tsunami Hub Script</h1>
      <p style={styles.subtitle}>Click the button below to copy the script</p>

      <div style={styles.codeBox}>
        <code>{script}</code>
      </div>

      <button style={styles.button} onClick={copyScript}>
        {copied ? "Copied ✅" : "Copy Script 📋"}
      </button>
    </div>
  );
}

const styles = {
  container: {
    height: "100vh",
    display: "flex",
    flexDirection: "column",
    justifyContent: "center",
    alignItems: "center",
    background: "#0f172a",
    color: "white",
    fontFamily: "Arial"
  },
  title: {
    fontSize: "40px",
    marginBottom: "10px"
  },
  subtitle: {
    opacity: 0.7,
    marginBottom: "25px"
  },
  codeBox: {
    background: "#020617",
    padding: "15px",
    borderRadius: "10px",
    marginBottom: "20px",
    maxWidth: "90%",
    overflowX: "auto"
  },
  button: {
    padding: "12px 25px",
    fontSize: "16px",
    borderRadius: "10px",
    border: "none",
    cursor: "pointer",
    background: "#38bdf8",
    color: "black",
    fontWeight: "bold"
  }
};
